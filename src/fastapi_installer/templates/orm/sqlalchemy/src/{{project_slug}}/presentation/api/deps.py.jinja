"""Dependency wiring: binds the domain's abstract repositories to SQLAlchemy implementations."""

from typing import Annotated

from fastapi import Depends
from sqlalchemy.ext.asyncio import AsyncSession

from {{ project_slug }}.application.users.service import UserService
from {{ project_slug }}.infrastructure.db.session import get_session, ping_database
from {{ project_slug }}.infrastructure.users.repository import SqlAlchemyUserRepository

SessionDep = Annotated[AsyncSession, Depends(get_session)]
DatabaseHealthDep = Annotated[bool, Depends(ping_database)]


def get_user_service(session: SessionDep) -> UserService:
    return UserService(SqlAlchemyUserRepository(session))


UserServiceDep = Annotated[UserService, Depends(get_user_service)]
